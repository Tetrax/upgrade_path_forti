*.key
*.pem
*.crt
*.cert
*.cer
*.der
*.p12
*.pfx
*.p7b
*.p7c

# Email credentials belong in read-only deployment secret files outside the repo,
# never in environment values — also guard against accidental real .env files.
*.env
.env*
!*.env.example
.claude/
data/*.log
data/fortios-data.generated.json
