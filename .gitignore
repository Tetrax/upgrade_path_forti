__pycache__/
*.py[cod]
.DS_Store
data/advisory-images/
data/fortios-health.json
data/fortios-notify-history.json
data/notification-settings.json*
data/smtp-settings.json*
data/email-transport-settings.json*
data/.email-transport-settings.json*
**/microsoft365-client-secret*
**/microsoft365-secrets/
**/smtp-secrets/
data/smtp-password*
data/.smtp-settings.json*
data/.smtp-password*
data/*.lock
.venv-compat/
.venv-test/
test-results/
playwright-report/
# TLS material must stay in the dedicated runtime volume, never in Git.
certificates/
*.key
*.pem
*.crt
*.cert
*.cer
*.der
*.p12
*.pfx
*.p7b
*.p7c

# Email credentials belong in private persistent secret files outside the repo,
# never in environment values — also guard against accidental real .env files.
*.env
.env*
!*.env.example
.claude/
data/*.log
data/fortios-data.generated.json

# Local visual-preview artifacts (email renders, screenshots) — not for Git.
.artifacts/

# Trivy report produced locally (CI keeps its own copy as the `trivy-report` artifact).
trivy.json
trivy-report.json
trivy-report.meta.json

# Canonical workspace runtime (live compose file, persistent data, runtime docs and
# rollback archives). The repository's own data/ and docs/ track samples and guides, so the
# live state must never be mounted over them.
runtime/
