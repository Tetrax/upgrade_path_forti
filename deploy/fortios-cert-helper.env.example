# Copy to /etc/fortios-cert-helper.env with mode 0600 and adapt the hostname.
PUID=1000
PGID=1000
FORTIOS_TLS_HOSTNAME=fortiupgrade.example.internal
FORTIOS_CERT_OUTPUT_DIR=/var/lib/fortiupgrade/certificates/active
FORTIOS_CERT_ADMIN_FILE=/var/lib/fortiupgrade/certificates/admin/credentials.json
FORTIOS_CERT_HELPER_SOCKET=/run/fortios-cert-helper/helper.sock
FORTIOS_CERT_RELOAD_NGINX=1
