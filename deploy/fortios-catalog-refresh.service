[Unit]
Description=FortiOS Upgrade Intelligence — catalog refresh (new models / new versions, all products)

[Service]
Type=oneshot
User=tetrax
Group=tetrax
WorkingDirectory=/home/tetrax/workspace/upgrade_path
# Optional SMTP notification config. The shared runner uses the host compatibility venv and
# holds one lock across the catalog and compatibility phases.
EnvironmentFile=-/etc/fortios-upgrade-intelligence.env
ExecStart=/usr/bin/python3 scripts/scheduled_refresh.py full
