# Exemple de configuration des transports email FortiUpgrade.
#
# Copier ce fichier en /etc/fortios-upgrade-intelligence.env (hors du dépôt Git, permissions
# restreintes, ex: chmod 600 root:root ou tetrax:tetrax selon l'utilisateur du service), puis
# renseigner de vraies valeurs. Ne JAMAIS committer de vrais identifiants dans ce dépôt.
#
# L'activation, les produits surveillés et les destinataires sont administrés dans l'interface
# puis enregistrés dans data/notification-settings.json. Aucun secret n'y est stocké.

# Bootstrap SMTP ; les paramètres enregistrés dans la GUI prévalent.
FORTIOS_SMTP_HOST=
FORTIOS_SMTP_PORT=587
FORTIOS_SMTP_USERNAME=
# Fichier séparé, jamais de mot de passe en clair dans l'environnement.
# Docker : volume dédié web RW / scheduler RO. Installation native : préparer
# un répertoire privé persistant 0700 appartenant au compte du service web.
# Migrer le fichier existant avant de changer sa référence (docs/delivery.md).
FORTIOS_SMTP_PASSWORD_FILE=/opt/fortios/smtp-secrets/password
FORTIOS_SMTP_STARTTLS=true
FORTIOS_SMTP_TIMEOUT=10

# Expéditeur SMTP. Les destinataires sont configurés dans l'interface web.
FORTIOS_SMTP_FROM=

# Utilisé dans le corps des emails (lien vers l'application).
FORTIOS_APP_URL=https://valdev.me:3001/

# Microsoft 365 facultatif ; les paramètres non secrets enregistrés dans l'UI prévalent.
# Voir docs/microsoft365.md. Le secret reste uniquement dans un fichier protégé.
FORTIOS_EMAIL_TRANSPORT=smtp
FORTIOS_MICROSOFT365_TENANT_ID=
FORTIOS_MICROSOFT365_CLIENT_ID=
FORTIOS_MICROSOFT365_FROM=
FORTIOS_MICROSOFT365_DISPLAY_NAME=
FORTIOS_MICROSOFT365_MAILBOX_IDENTITY=
# Docker : volume dédié web rw / scheduler ro, initialisé par l'entrypoint.
# Installation native : adapter à un répertoire privé persistant, 0700,
# appartenant au compte du service web et lisible par le scheduler du même compte.
FORTIOS_MICROSOFT365_CLIENT_SECRET_FILE=/opt/fortios/microsoft365-secrets/client-secret
FORTIOS_MICROSOFT365_TIMEOUT=10
