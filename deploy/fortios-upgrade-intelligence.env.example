# Exemple de configuration de l'infrastructure SMTP FortiUpgrade.
#
# Copier ce fichier en /etc/fortios-upgrade-intelligence.env (hors du dépôt Git, permissions
# restreintes, ex: chmod 600 root:root ou tetrax:tetrax selon l'utilisateur du service), puis
# renseigner de vraies valeurs. Ne JAMAIS committer de vrais identifiants dans ce dépôt.
#
# L'activation, les produits surveillés et les destinataires sont administrés dans l'interface
# puis enregistrés dans data/notification-settings.json. Aucun secret n'y est stocké.

# Serveur SMTP.
FORTIOS_SMTP_HOST=
FORTIOS_SMTP_PORT=587
FORTIOS_SMTP_USERNAME=
# Chemin d'un fichier secret lisible par le service. Ne pas définir de password SMTP en clair.
FORTIOS_SMTP_PASSWORD_FILE=
FORTIOS_SMTP_STARTTLS=true
FORTIOS_SMTP_TIMEOUT=10

# Expéditeur SMTP. Les destinataires sont configurés dans l'interface web.
FORTIOS_SMTP_FROM=

# Utilisé dans le corps des emails (lien vers l'application).
FORTIOS_APP_URL=https://valdev.me:3001/app/
