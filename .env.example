# Copy to .env on the Docker/Portainer host. Do not commit .env.
# Existing host data uses UID:GID 1000:1000; adapt if the target host differs.
PUID=1000
PGID=1000

# Web endpoint: keep loopback-only when a host reverse proxy is used.
FORTIOS_HTTP_BIND_ADDRESS=127.0.0.1
FORTIOS_HTTP_PORT=8000

# After installing a certificate with scripts/certctl.py, set both paths and
# publish the same listener on host port 443. TLS replaces plaintext HTTP.
FORTIOS_TLS_CERT=
FORTIOS_TLS_KEY=
FORTIOS_TLS_HOSTNAME=

# Private /cert administration. Create this file interactively with
# fortios-cert-admin; never put the password in this environment file.
FORTIOS_CERT_ADMIN_FILE=/opt/fortios/certificates/admin/credentials.json
FORTIOS_CERT_OUTPUT_DIR=/opt/fortios/certificates/active
# Reverse-proxy mode: list only the exact proxy source addresses/CIDRs seen by
# the container. Forwarded HTTPS/client headers are ignored from every other peer.
FORTIOS_CERT_TRUSTED_PROXY_CIDRS=
# Optional host helper. Keep empty for validation-only mode.
FORTIOS_CERT_HELPER_SOCKET=
FORTIOS_CERT_HELPER_SOCKET_DIR=/run/fortios-cert-helper
# Local loopback test only; do not enable either flag in the Docker Stack.
FORTIOS_CERT_ALLOW_INSECURE_LOCALHOST=0
FORTIOS_CERT_DIRECT_INSTALL=0

# Absolute host paths are recommended for a Portainer Stack. Defaults in the
# compose file remain ./data and ./docs for a local docker compose run.
FORTIOS_DATA_DIR=/opt/upgrade_path/data
FORTIOS_DOCS_DIR=/opt/upgrade_path/docs
FORTIOS_CERTS_DIR=/opt/upgrade_path/certificates
# Keep rw for direct TLS installs. Set ro when using the privileged host helper.
FORTIOS_CERTS_MOUNT_MODE=rw

# Set to 1 only for a controlled initial catalog refresh after first deployment.
FORTIOS_RUN_ON_START=0

# SMTP infrastructure only. Enablement, monitored products and recipients are
# stored through Administration > Notifications in data/notification-settings.json.
# Never put the SMTP password in this file or in a Portainer environment field.
FORTIOS_SMTP_HOST=
FORTIOS_SMTP_PORT=587
FORTIOS_SMTP_USERNAME=
# Mount a 0600 secret file and set its in-container path here. The provided
# Compose stacks deliberately do not forward a plaintext password variable.
FORTIOS_SMTP_PASSWORD_FILE=
FORTIOS_SMTP_STARTTLS=true
FORTIOS_SMTP_TIMEOUT=10
FORTIOS_SMTP_FROM=
FORTIOS_APP_URL=https://upgrade-path.example.internal/app/
